# Copy this file to .env.docker and fill in real secrets locally.
# Never commit .env.docker.

OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

LLM_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_COLLECTION=lecture_chunks
TOP_K=5
MAX_RETRIES=3
EMBEDDING_BATCH_SIZE=64
MAX_PAGE_CHARS=16000
PAGE_RENDER_DPI=160
VISION_DETAIL=original

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AUTH_COOKIE_NAME=ai_review_session
AUTH_COOKIE_SAMESITE=none
PASS_SCORE_THRESHOLD=60
