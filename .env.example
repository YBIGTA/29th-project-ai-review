# Copy this file to .env and fill in secrets locally. Never commit .env.

# AI services
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# RAG
LLM_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_PATH=./vector_db
CHROMA_COLLECTION=lecture_chunks
TOP_K=5
MAX_RETRIES=3
EMBEDDING_BATCH_SIZE=64
MAX_PAGE_CHARS=16000
PAGE_RENDER_DPI=160
VISION_DETAIL=original

# PostgreSQL
DATABASE_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend / browser session
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
AUTH_COOKIE_NAME=ai_review_session
AUTH_COOKIE_SECURE=false
