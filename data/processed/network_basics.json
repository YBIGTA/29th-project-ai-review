    {
      "chunk_id": "network_basics_p6_01",
      "lecture_id": "network_basics",
      "lecture_name": "네트워크 기초",
      "page": 6,
      "topic": "패킷 교환",
      "concepts": [
        "packet",
        "router",
        "switch"
      ],
      "raw_text": "컴퓨터 네트워크 시작하기\n패킷 교환 방식\n\n메세지를 패킷이라는 작은 단위로 쪼개어 송수신하는 방식 (회선 교환 방식 문제 해결)\n\n\n\n\n\n패킷 스위치 : 패킷이 수신지까지 올바르게 도달할 수 있도록 최적의 경로를 결정하거\n나 패킷의 송수신지를 식별\n\nex) 라우터(router), 스위치(switch)",
      "visual_description": "메시지를 작은 패킷으로 나눠 보내며 라우터·스위치가 수신지와 경로를 판단한다.",
      "content": "메시지를 작은 패킷으로 나눠 보내며 라우터·스위치가 수신지와 경로를 판단한다.",
      "page_role": "core_content",
      "term_ids": [
        "packet",
        "packet_switching",
        "router",
        "switch"
      ],
      "evidence_units": [
        {
          "unit_id": "net_p6",
          "type": "procedure",
          "source_type": "text",
